library project Escape is

   --  The scenario variable is the whole platform story. Nothing else in
   --  the library knows which backing exists; the demo's Game_ECS picks.
   --  Both backings are always compiled here; TARGET matters in demo/.

   for Library_Name use "escape";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnatyg", "-gnatyM100", "-g", "-O2", "-fstack-check");
      --  Signature packages declare formals that nothing inside them uses.
      --  That is what a signature package IS; the warning is noise here.
      for Switches ("ecs-sequences.ads")   use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatwU", "-gnatyg", "-gnatyM100", "-g", "-O2");
      for Switches ("ecs-sparse_maps.ads") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatwU", "-gnatyg", "-gnatyM100", "-g", "-O2");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "-j0");
   end Prove;

end Escape;
